# Доступы Yandex Cloud / AI Studio. Заполняются значениями от заказчика.
# Файл .env в .gitignore, в репозиторий не попадает.

# API-ключ сервисного аккаунта с ролью search-api.webSearch.user (начинается с AQVN…).
YANDEX_API_KEY=

# ID каталога, в котором живёт сервисный аккаунт.
YANDEX_FOLDER_ID=

# Необязательно. Если ключ хранится в API-доступах облачного окружения
# Claude Code и подставляется прокси, YANDEX_API_KEY не нужен — вместо него:
# YANDEX_AUTH_VIA_PROXY=1
